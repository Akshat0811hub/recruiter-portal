{
  "manifest_version": 3,
  "name": "TalentFlow CRM Sync (WhatsApp + Gmail)",
  "version": "3.1.0",
  "description": "Real-time WhatsApp Web and Gmail conversation synchronization for TalentFlow CRM with automatic failover and offline queuing.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://web.whatsapp.com/*",
    "https://mail.google.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TalentFlow CRM Sync"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["gmail.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
