{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**,public/**",
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/sales/api/(.*)", "destination": "/api/index.js" },
    { "source": "/sales/webhook", "destination": "/api/index.js" },
    { "source": "/phone", "destination": "/phone.html" },
    { "source": "/sales", "destination": "/sales/index.html" },
    { "source": "/sales/", "destination": "/sales/index.html" },
    { "source": "/sales/(.*)", "destination": "/api/index.js" }
  ]
}
