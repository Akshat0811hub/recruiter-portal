{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**,public/**",
      "maxDuration": 15
    },
    "api/[...path].js": {
      "includeFiles": "data/**,public/**",
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/sales/api/:path*", "destination": "/api/index.js?__vpath=/sales/api/:path*" },
    { "source": "/sales/webhook", "destination": "/api/index.js?__vpath=/sales/webhook" },
    { "source": "/download/:path*", "destination": "/api/index.js?__vpath=/download/:path*" },
    { "source": "/phone", "destination": "/phone.html" },
    { "source": "/sales", "destination": "/sales/index.html" },
    { "source": "/sales/", "destination": "/sales/index.html" },
    { "source": "/sales/phone", "destination": "/sales/phone.html" }
  ]
}
