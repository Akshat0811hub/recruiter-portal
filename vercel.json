{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**,public/**",
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js?__vpath=/api/$1" },
    { "source": "/sales/api/(.*)", "destination": "/api/index.js?__vpath=/sales/api/$1" },
    { "source": "/sales/webhook", "destination": "/api/index.js?__vpath=/sales/webhook" },
    { "source": "/download/(.*)", "destination": "/api/index.js?__vpath=/download/$1" },
    { "source": "/phone", "destination": "/phone.html" },
    { "source": "/sales", "destination": "/sales/index.html" },
    { "source": "/sales/", "destination": "/sales/index.html" },
    { "source": "/sales/phone", "destination": "/sales/phone.html" },
    { "source": "/sales/(.*)", "destination": "/api/index.js?__vpath=/sales/$1" }
  ]
}
